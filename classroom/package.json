{
  "name": "docuscope-classroom",
  "version": "5.3.13",
  "description": "Visualization of DocuScope analytics of a set of documents.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/CMU_Sidecar/docuscope-classroom.git"
  },
  "author": "Michael Ringenberg <ringenberg@cmu.edu>",
  "license": "CC BY-NC-SA 4.0",
  "bugs": {
    "url": "https://gitlab.com/CMU_Sidecar/docuscope-classroom/issues"
  },
  "homepage": "https://gitlab.com/CMU_Sidecar/docuscope-classroom#readme",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --output-hashing none",
    "build:docuscope": "ng build --base-href=/classroom/ --configuration=production",
    "build:dev": "ng build --base-href=/classroom/ --output-hashing none --configuration=development",
    "build:exodar": "ng build --base-href=/docuscope/classroom/ --configuration=production",
    "test": "ng test",
    "test_headless": "cross-env CI=true ng test --progress=false --watch=false",
    "lint": "eslint -c .eslintrc.json src",
    "prettier": "prettier -w src",
    "e2e": "ng e2e",
    "dep_check": "npx dpdm src",
    "version": "node getVersion.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "angular-split": "^20.0.0",
    "core-js": "^3.48.0",
    "d3": "^7.9.0",
    "rxjs": "^7.8.2",
    "rxjs-compat": "^6.6.7",
    "service": "^0.1.4",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/language-service": "^22.1.0",
    "@eslint/js": "^9.7.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/browser-playwright": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-formatter-gitlab": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "^5.5.5",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "karma": "^6.4.4",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "^7.3.5",
    "esbuild": "^0.28.1",
    "undici": ">7.27.2",
    "piscina": ">5.1.4",
    "@babel/core": ">7.29.0",
    "@hono/node-server": ">=2.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "msgpackr-extract@3.0.4": true,
    "core-js@3.50.0": true,
    "lmdb@3.5.6": true,
    "@parcel/watcher@2.6.0": true
  }
}
